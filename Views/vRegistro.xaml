<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandezS3.Views.vRegistro"
             Title="vRegistro">


    <ContentPage.Resources >

        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Maroon" />
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            </Style>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
        </Style>
    </ContentPage.Resources>
    <VerticalStackLayout
        Padding="15"
        Spacing="15"
        Background="DarkBlue">
        
        <Label 
            Text="Registrar Usuario"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        
        <Entry x:Name="txtUsuarioNuevo"
               Placeholder="Ingrese el nuevo usuario" />
        <Entry x:Name="txtContrasenaNueva"
               Placeholder="Ingrese la nueva contraseña"
               IsPassword="True" />
        
        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="btnRegistrar"
                    Text="Registrar"
                    Style="{StaticResource BotonGlobal}"
                    Clicked="btnRegistrar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"/>
            <Button x:Name="btnCancelar"
                    Text="Cancelar"
                    Clicked="btnCancelar_Clicked"  
                    Grid.Row="0"
                    Grid.Column="1"/>
            </Grid>

    </VerticalStackLayout>
</ContentPage>